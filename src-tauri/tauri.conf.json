{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MA Haber Merkezi",
  "version": "1.0.0",
  "identifier": "com.ajansma.habermerkezi",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Turkish",
          "English"
        ]
      }
    },
    "shortDescription": "Mezopotamya Ajansı haber merkezi",
    "longDescription": "Mezopotamya Ajansı haber merkezine masaüstü uygulamasından güvenli erişim.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "publisher": "Mezopotamya Ajansı",
    "copyright": "© 2026 Mezopotamya Ajansı",
    "category": "News"
  }
}
